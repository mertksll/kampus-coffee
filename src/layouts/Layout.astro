---
import AppHeader from "../components/AppHeader.svelte";
import "../styles/app.css";
interface Props {
  title?: string;
  lang?: string;
  frontmatter?: { title?: string; lang?: string };
}
const { frontmatter = {} } = Astro.props;
const title = Astro.props.title ?? frontmatter.title ?? "Kampus's Coffee";
const lang = Astro.props.lang ?? frontmatter.lang ?? "tr";
const labels: Record<string, string[]> = {
  tr: [
    "Hakkında",
    "İletişim",
    "Kullanım koşulları",
    "Gizlilik",
    "Sipariş rehberi",
    "Kampüsün kahvesi, sınıfının kapısında.",
  ],
  en: ["About", "Contact", "Terms of use", "Privacy", "Ordering guide", "Campus coffee at your classroom door."],
  ar: ["حول التطبيق", "تواصل معنا", "شروط الاستخدام", "الخصوصية", "دليل الطلب", "قهوة الجامعة إلى باب قاعتك."],
  fa: ["درباره", "تماس", "شرایط استفاده", "حریم خصوصی", "راهنمای سفارش", "قهوه دانشگاه تا در کلاس شما."],
};
const words = labels[lang] ?? labels.tr;
const pages = ["hakkinda", "iletisim", "kosullar", "gizlilik", "rehber"];
const current = Astro.url.pathname.split("/").filter(Boolean).at(-1) ?? "hakkinda";
const info = pages.includes(current) ? current : "hakkinda";
const detail = Astro.url.pathname.match(/\/urun\/(\d+)\/?$/);
const isMenu = /^\/(en\/|ar\/|fa\/)?$/.test(Astro.url.pathname);
const prefix = lang === "tr" ? "" : "/" + lang;
---

<!doctype html>
<html lang={lang} dir={["ar", "fa"].includes(lang) ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={words[5]} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem("tema");
        document.documentElement.dataset.tema =
          t === "gece" || (t !== "gunduz" && matchMedia("(prefers-color-scheme:dark)").matches)
            ? "gece"
            : "gunduz";
      } catch {
        document.documentElement.dataset.tema = "gunduz";
      }
    </script>
  </head>
  <body>
    <AppHeader client:load lang={lang} currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/" class="footer-brand">
        Kampus's Coffee<span>Her molaya bir kahve.</span>
      </a>
      <nav class="info-nav" aria-label={words[0]}>
        {pages.map((page, i) => (
          <a href={`${prefix}/${page}/`}>{words[i]}</a>
        ))}
      </nav>
      <nav class="language-nav" aria-label="Language / Dil">
        {[
          ["tr", "Türkçe"],
          ["en", "English"],
          ["ar", "العربية"],
          ["fa", "فارسی"],
        ].map(([code, name]) => (
          <a
            href={`${code === "tr" ? "" : "/" + code}${detail ? "/urun/" + detail[1] + "/" : isMenu ? "/" : "/" + info + "/"}`}
            lang={code}
            hreflang={code}
            aria-current={lang === code ? "page" : undefined}
          >
            {name}
          </a>
        ))}
      </nav>
      <p class="muted">{words[5]}</p>
    </footer>
  </body>
</html>
